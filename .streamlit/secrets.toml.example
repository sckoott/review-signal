# Copy this file to .streamlit/secrets.toml (same folder) and fill in ONE key.
# Environment variables with the same names take precedence over this file.
# Never commit secrets.toml.

ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-sonnet-5-5"          # default

# Or use OpenRouter instead of the Anthropic API:
# OPENROUTER_API_KEY = "sk-or-..."
# OPENROUTER_MODEL = "anthropic/claude-sonnet-5.5" # default

# Optional
# LLM_PROVIDER = "auto"            # auto | anthropic | openrouter | none
# GENIE_SPACE_ID = "01ef..."       # enables Databricks Genie on the Data Q&A page
# EXEC_EMAILS = "cdo@company.com"  # these users land on the Exec Brief
# FRESHNESS_CUTOFF = "2026-01-01"
